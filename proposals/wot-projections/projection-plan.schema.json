{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experimental WoT Projection Plan (compact shape)",
  "description": "Checks the conventional compact spelling only. Does not expand JSON-LD or validate projection semantics.",
  "type": "object",
  "required": ["@type", "id", "wotproj:scenario", "wotproj:projects"],
  "not": { "required": ["wotproj:projectionKind"] },
  "anyOf": [
    { "required": ["properties"], "properties": { "properties": { "minProperties": 1 } } },
    { "required": ["actions"], "properties": { "actions": { "minProperties": 1 } } },
    { "required": ["events"], "properties": { "events": { "minProperties": 1 } } },
    {
      "properties": {
        "wotproj:projects": {
          "contains": {
            "anyOf": [
              { "required": ["wotproj:selectAll"], "properties": { "wotproj:selectAll": { "const": true } } },
              { "required": ["wotproj:select"], "properties": { "wotproj:select": { "minItems": 1 } } }
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "@type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "wotproj:projection" },
      "oneOf": [{ "contains": { "const": "Thing" } }, { "contains": { "const": "tm:ThingModel" } }]
    },
    "id": { "type": "string", "format": "iri" },
    "wotproj:scenario": { "type": "string", "format": "iri" },
    "wotproj:projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    },
    "properties": { "$ref": "#/definitions/affordanceMap" },
    "actions": { "$ref": "#/definitions/affordanceMap" },
    "events": { "$ref": "#/definitions/affordanceMap" }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": ["wotproj:sourceName", "href", "type"],
      "properties": {
        "wotproj:sourceName": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "format": "uri-reference", "pattern": "^[^#]*$" },
        "type": { "enum": ["application/td+json", "application/tm+json"] },
        "wotproj:routing": { "enum": ["source", "projection"] },
        "wotproj:sourceDigest": { "type": "string", "pattern": "^sha-256:[0-9a-f]{64}$" },
        "wotproj:namePrefix": { "type": "string" },
        "wotproj:selectAll": { "type": "boolean" },
        "wotproj:select": {
          "type": "array",
          "items": { "$ref": "#/definitions/predicate" }
        }
      }
    },
    "predicate": {
      "type": "object",
      "properties": {
        "wotproj:affordanceKind": { "enum": ["property", "action", "event"] },
        "@type": { "$ref": "#/definitions/typeValues" }
      },
      "additionalProperties": false
    },
    "typeValues": {
      "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "affordanceMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tm:ref": { "type": "string", "format": "uri-reference" },
          "@type": { "$ref": "#/definitions/typeValues" },
          "wotproj:observe": { "type": "object" }
        }
      }
    }
  }
}
